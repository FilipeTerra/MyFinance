# .env.example — modelo de configuração da camada AiAgent.
# Copie para .env e preencha. O .env real é git-ignored (NUNCA versione segredos).
#   cp .env.example .env

# ── Provedor Ollama remoto (proxy) ──────────────────────────────────────────
REMOTE_OLLAMA_URL=http://ollama.futurelab.dcc.ufmg.br
# SEGREDO — chave individual do proxy. Deixe vazio para desativar o provedor
# remoto (o sistema cai para o Ollama local automaticamente).
REMOTE_OLLAMA_API_KEY=

# ── Ollama local (fallback) ─────────────────────────────────────────────────
LOCAL_OLLAMA_URL=http://localhost:11434

# ── Modelos por papel (opcional — há defaults no settings.py) ───────────────
CHAT_MODEL_LOCAL=gemma4:latest
CHAT_MODEL_REMOTE=llama3.1:8b
CLASSIFIER_MODEL_LOCAL=llama3.2:3b
CLASSIFIER_MODEL_REMOTE=llama3.2:3b
EMBEDDING_MODEL_LOCAL=nomic-embed-text
EMBEDDING_MODEL_REMOTE=nomic-embed-text:latest
EXTRACTOR_MODEL_LOCAL=qwen2.5:7b
EXTRACTOR_MODEL_REMOTE=llama3.2:3b

# ── Backend .NET ────────────────────────────────────────────────────────────
API_URL=http://localhost:5088/api

# ── Logging ─────────────────────────────────────────────────────────────────
# Defina como 1/true para logs em nível DEBUG.
MYFINANCE_DEBUG=
