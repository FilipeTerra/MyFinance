<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Segredos (token do brapi, connection string, JWT secret) ficam fora do controle
         de versão. Dev: arquivo .env na raiz de MyFinance.Api (ex: BRAPI_TOKEN=...,
         ConnectionStrings__DefaultConnection=..., JwtSettings__Secret=..., ignorado pelo
         git — ver Program.cs/DotEnvLoader), mesmo padrão do .env do MyFinance.AiAgent.
         Prod: variáveis de ambiente equivalentes (ex: ExternalServices__Brapi__Token,
         ConnectionStrings__DefaultConnection, JwtSettings__Secret).
         UserSecretsId mantido como alternativa suportada nativamente pelo .NET. -->
    <UserSecretsId>myfinance-api-3f9c2a10-6b4e-4d21-9c88-2ab7e5d10f43</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyFinance.Application\MyFinance.Application.csproj" />
    <ProjectReference Include="..\MyFinance.Infrastructure\MyFinance.Infrastructure.csproj" />
  </ItemGroup>

</Project>
