# .env.example — modelo de configuração da API .NET.
# Copie para .env e preencha. O .env real é git-ignored (NUNCA versione segredos).
#   cp .env.example .env

# ── brapi.dev (dados de mercado da B3) ──────────────────────────────────────
# SEGREDO — token gratuito obtido em https://brapi.dev. Sem ele, apenas os
# tickers livres do plano gratuito respondem (ex: PETR4, VALE3, ITUB4, MGLU3).
BRAPI_TOKEN=

# ── Banco de dados (Postgres local) ─────────────────────────────────────────
# SEGREDO — string de conexão completa (usuário/senha inclusos). Nomeação
# hierárquica com "__" equivale a ":" na configuração do .NET (ConnectionStrings:DefaultConnection).
ConnectionStrings__DefaultConnection=Host=localhost;Database=MyFinance;Username=MyFinance_user;Password=

# ── JWT (autenticação da API) ───────────────────────────────────────────────
# SEGREDO — chave usada para assinar/validar os tokens JWT emitidos pela API.
JwtSettings__Secret=
